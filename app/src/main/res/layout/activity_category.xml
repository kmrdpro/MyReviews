<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/category_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="12dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="МОЯ КОЛЛЕКЦИЯ"
            android:textColor="@color/accent_purple"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.12" />

        <TextView
            android:id="@+id/tvCategoryTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Название категории"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/light_text_primary"
            android:maxLines="2"
            android:ellipsize="end" />

        <Button
            android:id="@+id/btnSortProducts"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_gravity="end"
            android:layout_marginTop="10dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="⇅ Сортировка"
            android:textAllCaps="false"
            android:textSize="13sp" />


        <EditText
            android:id="@+id/etSearchProduct"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:hint="Поиск товаров..."
            android:singleLine="true"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textSize="15sp"
            android:textColor="@color/light_text_primary"
            android:textColorHint="@color/light_text_secondary"
            android:background="@drawable/search_background"
            android:drawableStart="@android:drawable/ic_menu_search"
            android:drawablePadding="10dp" />


    </LinearLayout>





    <GridView
        android:id="@+id/listProducts"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp"
        android:numColumns="2"
        android:verticalSpacing="12dp"
        android:horizontalSpacing="10dp"
        android:columnWidth="0dp"
        android:stretchMode="columnWidth"
        android:gravity="center"
        android:padding="2dp"
        android:clipToPadding="false"
        android:scrollbars="vertical" />



    <Button
        android:id="@+id/btnAddProduct"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_gravity="end"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:padding="0dp"
        android:text="+"
        android:textSize="32sp"
        android:textAllCaps="false"
        android:background="@drawable/add_button_background"
        android:backgroundTint="@null"
        android:textColor="#34234F" />


</LinearLayout>