<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp"
    android:background="@drawable/category_card_background">

    <TextView
        android:id="@+id/tvCategoryIcon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:gravity="center"
        android:text="🛒"
        android:textSize="24sp"
        android:background="@drawable/category_icon_background" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="14dp">

        <TextView
            android:id="@+id/tvCategoryName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Название категории"
            android:textColor="#F3EFF7"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvProductCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="0 товаров"
            android:textColor="#BDB6C7"
            android:textSize="13sp" />

    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="›"
        android:textColor="#D0BCFF"
        android:textSize="30sp" />

</LinearLayout>